# Copie para .env e preencha. NUNCA versione o .env.
AIRFLOW_UID=50000
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=troque-esta-senha

# Databricks (deixe vazio para rodar só a coleta local em chegada/)
DATABRICKS_HOST=https://<seu-workspace>.cloud.databricks.com
DATABRICKS_TOKEN=
DATABRICKS_JOB_ID=
DATABRICKS_VOLUME_PATH=/Volumes/workspace/agroconecta_bronze/chegada
